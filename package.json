    "maplibre-gl": "^5.24.0",
    "deck.gl": "^9.3.3",
    "satellite.js": "^6.0.2",
    "react-markdown": "^10.1.0",
    "date-fns": "^4.1.0",
    "rss-parser": "^3.13.0",
    "yahoo-finance2": "^3.15.3",
